# ──────────────────────────────────────────────────────────────────────────────
# GuardianDesk Parent Dashboard — environment variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — it is listed in .gitignore.
#
# All VITE_ prefixed variables are embedded into the browser bundle at build
# time by Vite.  Do NOT put secrets here that must stay server-side.
# The anon key is safe to expose: it is rate-limited and RLS-protected.
# ──────────────────────────────────────────────────────────────────────────────

# Your Supabase project URL  (Settings → API → Project URL)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Your Supabase anon/public key  (Settings → API → anon public)
VITE_SUPABASE_ANON_KEY=eyJ...

# Optional: Gemini API key for the AI Report modal
# Get one from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
